{
  "name": "calculadora-grafica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "comprobar": "node comprobar/recorrido.mjs",
    "pruebas": "tsx src/nucleo/pruebas-expresion.ts",
    "mate": "tsx src/nucleo/pruebas-matematicas.ts",
    "app": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app:dev": "node electron/dev.mjs",
    "app:empaquetar": "npm run build && node electron/empaquetar.mjs",
    "comprobar:app": "npm run build && node comprobar/app.mjs",
    "app:instalar": "npm run app:empaquetar && node electron/instalar.mjs",
    "app:empaquetar:mac": "npm run build && node electron/empaquetar.mjs mac",
    "app:empaquetar:linux": "npm run build && node electron/empaquetar.mjs linux",
    "app:distribuir:linux": "npm run build && node electron/empaquetar.mjs linux --distribuir",
    "pruebas:escritorio": "node --test comprobar/plataforma.test.cjs",
    "pruebas:herramientas": "tsx src/nucleo/pruebas-herramientas.ts",
    "comprobar:menus": "npm run build && node comprobar/menus.mjs",
    "comprobar:paquete": "node comprobar/empaquetado.mjs",
    "pruebas:laboratorio": "tsx src/nucleo/pruebas-laboratorio.ts"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "es.luichi.calculadora",
    "productName": "Calculadora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/plataforma.cjs",
      "README.md",
      "package.json",
      "!node_modules/**/*",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dir"
      ],
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Calculadora gráfica"
      },
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      {
        "ext": "calc",
        "name": "Sesión de Calculadora",
        "role": "Editor",
        "mimeType": "application/x-calculadora"
      }
    ],
    "asarUnpack": [
      "README.md"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "calculadora",
      "category": "Education",
      "icon": "build/icon.png",
      "mimeTypes": [
        "application/x-calculadora"
      ],
      "desktop": {
        "entry": {
          "Name": "Calculadora gráfica",
          "Categories": "Education;Math;Science;",
          "StartupWMClass": "es.luichi.calculadora"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "maintainer": "Calculadora"
    }
  },
  "description": "Calculadora gráfica de matemáticas y física para macOS y Linux",
  "author": {
    "name": "Calculadora"
  },
  "desktopName": "es.luichi.calculadora.desktop"
}
