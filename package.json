{
  "name": "calculadora-grafica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "comprobar": "node comprobar/recorrido.mjs",
    "pruebas": "tsx src/nucleo/pruebas-expresion.ts",
    "mate": "tsx src/nucleo/pruebas-matematicas.ts",
    "app": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "app:dev": "node electron/dev.mjs",
    "app:empaquetar": "npm run build && electron-builder --mac dir",
    "comprobar:app": "npm run build && node comprobar/app.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "es.luichi.calculadora",
    "productName": "Calculadora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "README.md",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": "calc",
        "name": "Sesión de Calculadora",
        "role": "Editor"
      }
    ],
    "asarUnpack": [
      "README.md"
    ]
  }
}
